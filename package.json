{
  "name": "bwoc-vscode-extension",
  "displayName": "BWOC Fleet",
  "version": "0.6.0",
  "private": true,
  "description": "Operate your BWOC agent fleet from VS Code — a native control surface over the bwoc CLI (bwocd remote + Copilot integration to come).",
  "publisher": "bemindlabs",
  "homepage": "https://github.com/bemindlabs/bwoc-vscode-extension",
  "repository": "https://github.com/bemindlabs/bwoc-vscode-extension",
  "license": "MIT",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "bwoc",
    "agents",
    "fleet",
    "orchestration"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bwoc",
          "title": "BWOC",
          "icon": "media/bwoc.svg"
        }
      ]
    },
    "views": {
      "bwoc": [
        {
          "id": "bwocFleet",
          "name": "Fleet",
          "icon": "media/bwoc.svg"
        },
        {
          "id": "bwocTeams",
          "name": "Teams & Tasks",
          "icon": "media/bwoc.svg"
        },
        {
          "id": "bwocMemory",
          "name": "Memory",
          "icon": "media/bwoc.svg"
        },
        {
          "id": "bwocProfiles",
          "name": "Agent Profiles",
          "icon": "media/bwoc.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "bwoc.refreshFleet",
        "title": "BWOC: Refresh Fleet",
        "icon": "$(refresh)"
      },
      {
        "command": "bwoc.refreshTeams",
        "title": "BWOC: Refresh Teams",
        "icon": "$(refresh)"
      },
      {
        "command": "bwoc.refreshMemory",
        "title": "BWOC: Refresh Memory",
        "icon": "$(refresh)"
      },
      {
        "command": "bwoc.refreshProfiles",
        "title": "BWOC: Refresh Agent Profiles",
        "icon": "$(refresh)"
      },
      {
        "command": "bwoc.openMemory",
        "title": "BWOC: Open Memory Entry"
      },
      {
        "command": "bwoc.openAgentDetail",
        "title": "BWOC: Show Agent Detail"
      },
      {
        "command": "bwoc.sendMessage",
        "title": "BWOC: Send Message to Agent",
        "icon": "$(comment)"
      },
      {
        "command": "bwoc.openChat",
        "title": "BWOC: Chat with Agent",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "bwoc.runTask",
        "title": "BWOC: Run Task on Agent",
        "icon": "$(play)"
      },
      {
        "command": "bwoc.enrollController",
        "title": "BWOC: Enroll This Controller (remote bwocd)",
        "icon": "$(key)"
      },
      {
        "command": "bwoc.remoteStatus",
        "title": "BWOC: Remote Status / Who Am I (bwocd)",
        "icon": "$(account)"
      },
      {
        "command": "bwoc.switchHost",
        "title": "BWOC: Switch Fleet Host",
        "icon": "$(server-environment)"
      },
      {
        "command": "bwoc.startAgent",
        "title": "BWOC: Start Agent Daemon",
        "icon": "$(debug-start)"
      },
      {
        "command": "bwoc.stopAgent",
        "title": "BWOC: Stop Agent Daemon",
        "icon": "$(debug-stop)"
      },
      {
        "command": "bwoc.viewInbox",
        "title": "BWOC: View Agent Inbox",
        "icon": "$(mail)"
      },
      {
        "command": "bwoc.taskAdd",
        "title": "BWOC: Add Task to Team",
        "icon": "$(add)"
      },
      {
        "command": "bwoc.taskClaim",
        "title": "BWOC: Claim Task",
        "icon": "$(check)"
      },
      {
        "command": "bwoc.taskComplete",
        "title": "BWOC: Complete Task",
        "icon": "$(pass)"
      },
      {
        "command": "bwoc.doctor",
        "title": "BWOC: Doctor — Diagnose Environment",
        "icon": "$(stethoscope)"
      },
      {
        "command": "bwoc.commandPalette",
        "title": "BWOC: Commands…"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "bwoc.switchHost",
          "when": "view == bwocFleet",
          "group": "navigation@1"
        },
        {
          "command": "bwoc.refreshFleet",
          "when": "view == bwocFleet",
          "group": "navigation@2"
        },
        {
          "command": "bwoc.refreshTeams",
          "when": "view == bwocTeams",
          "group": "navigation"
        },
        {
          "command": "bwoc.refreshMemory",
          "when": "view == bwocMemory",
          "group": "navigation"
        },
        {
          "command": "bwoc.refreshProfiles",
          "when": "view == bwocProfiles",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "bwoc.openChat",
          "when": "view == bwocFleet && viewItem == bwocAgent",
          "group": "1_act@1"
        },
        {
          "command": "bwoc.runTask",
          "when": "view == bwocFleet && viewItem == bwocAgent",
          "group": "1_act@2"
        },
        {
          "command": "bwoc.sendMessage",
          "when": "view == bwocFleet && viewItem == bwocAgent",
          "group": "1_act@3"
        },
        {
          "command": "bwoc.viewInbox",
          "when": "view == bwocFleet && viewItem == bwocAgent",
          "group": "2_info@1"
        },
        {
          "command": "bwoc.openAgentDetail",
          "when": "view == bwocFleet && viewItem == bwocAgent",
          "group": "2_info@2"
        },
        {
          "command": "bwoc.startAgent",
          "when": "view == bwocFleet && viewItem == bwocAgent",
          "group": "3_life@1"
        },
        {
          "command": "bwoc.stopAgent",
          "when": "view == bwocFleet && viewItem == bwocAgent",
          "group": "3_life@2"
        },
        {
          "command": "bwoc.taskAdd",
          "when": "view == bwocTeams && viewItem == bwocTeam",
          "group": "1_act@1"
        },
        {
          "command": "bwoc.taskClaim",
          "when": "view == bwocTeams && viewItem == bwocTaskOpen",
          "group": "1_act@1"
        },
        {
          "command": "bwoc.taskComplete",
          "when": "view == bwocTeams && viewItem == bwocTaskClaimed",
          "group": "1_act@1"
        }
      ]
    },
    "configuration": {
      "title": "BWOC",
      "properties": {
        "bwoc.binaryPath": {
          "type": "string",
          "default": "bwoc",
          "description": "Path to the `bwoc` CLI binary. Defaults to `bwoc` on PATH."
        },
        "bwoc.workspace": {
          "type": "string",
          "default": "",
          "description": "BWOC workspace root. Empty = auto-detect (first folder containing `.bwoc/`, else the first workspace folder)."
        },
        "bwoc.remote.url": {
          "type": "string",
          "default": "",
          "description": "bwocd control-daemon URL for a single remote / tailnet fleet. Empty = use the local bwoc CLI. For multiple fleets use `bwoc.remote.hosts` (this value folds in as an unnamed host)."
        },
        "bwoc.remote.hosts": {
          "type": "array",
          "default": [],
          "description": "Multiple bwocd fleet hosts to switch between (BWOC: Switch Fleet Host). The active host persists across sessions; the legacy `bwoc.remote.url` folds in as an extra host.",
          "items": {
            "type": "object",
            "required": ["url"],
            "properties": {
              "name": {
                "type": "string",
                "description": "Display name for this fleet (defaults to the URL)."
              },
              "url": {
                "type": "string",
                "description": "bwocd control-daemon URL, e.g. http://host.tailnet.ts.net:10130"
              }
            }
          }
        },
        "bwoc.mcp.command": {
          "type": "string",
          "default": "bwoc-mcp",
          "description": "Command that launches the bwoc-mcp server, exposed to Copilot agent-mode. Defaults to `bwoc-mcp` on PATH."
        },
        "bwoc.inbox.pollSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "description": "Seconds between inbox-notification polls. A notification is raised when an agent gains inbox messages. 0 disables inbox notifications."
        }
      }
    },
    "chatParticipants": [
      {
        "id": "bwoc.fleet",
        "name": "bwoc",
        "fullName": "BWOC Fleet",
        "description": "Query and coordinate your BWOC agent fleet",
        "isSticky": true,
        "commands": [
          {
            "name": "list",
            "description": "List all agents in the workspace"
          },
          {
            "name": "status",
            "description": "Show an agent's health and config"
          }
        ]
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "bwoc.mcp",
        "label": "BWOC Fleet (bwoc-mcp)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package --no-dependencies",
    "lint": "eslint src tests",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.101.0",
    "@vitest/coverage-v8": "^2.1.9",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "eslint": "^10.7.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.64.0",
    "vitest": "^2.1.0"
  }
}
